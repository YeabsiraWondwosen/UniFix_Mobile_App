<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_university" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_overlay" />

    <Button
        android:id="@+id/btnToggleTheme"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/input_background"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="🌙"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:cornerRadius="20dp" />

    <Button
        android:id="@+id/btnToggleLanguage"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_toStartOf="@id/btnToggleTheme"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#44FFFFFF"
        android:paddingHorizontal="12dp"
        app:cornerRadius="20dp"
        android:text="🌐 አማ"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="30dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        android:id="@+id/tvRegTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Teacher Registration"
                        android:textAlignment="center"
                        android:textColor="@color/unifix_blue"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRegSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:text="Scan both sides of your ID. Your name will be extracted automatically."
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/layoutIdPrefix"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/input_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="8dp"
                            android:text="DBU"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etStaffId"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Staff ID (e.g. 1234)"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAutoUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:paddingHorizontal="4dp"
                        android:text="Your username will be: teach..."
                        android:textColor="@color/unifix_blue"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@color/input_background"
                            android:hint="Create Password"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="50dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivShowPassword"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:alpha="0.4"
                            android:padding="14dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/text_primary" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@color/input_background"
                            android:hint="Confirm Password"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="50dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivShowConfirmPassword"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:alpha="0.4"
                            android:padding="14dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/text_primary" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/containerIdScanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnVerifyFront"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FFc107"
                            android:text="SCAN FRONT"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnVerifyBack"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FFc107"
                            android:text="SCAN BACK"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginBottom="16dp"
                        android:backgroundTint="@color/unifix_blue"
                        android:text="REGISTER ACCOUNT"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBackToLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Back to Login"
                        android:textAlignment="center"
                        android:textColor="@color/unifix_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>