<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_university"
    android:fitsSystemWindows="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_overlay" />

    <LinearLayout
        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentTop="true"
        android:background="@color/unifix_blue"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UniFix Admin"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcomeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Welcome, Admin"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/btnBell"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:backgroundTint="@color/input_background"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="22dp"
                android:text="🛎️"
                android:textSize="20sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/badgeContainer"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                app:cardBackgroundColor="#dc3545"
                app:cardCornerRadius="9dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvGlobalAlertBadge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:backgroundTint="#6c757d"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="22dp"
            android:text="⚙️"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topNavBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="30dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/tabLayoutContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="horizontal"
                        android:weightSum="4"> <Button
                        android:id="@+id/btnTabReports"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/unifix_blue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Overview"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnTabUsers"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/input_background"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Users"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1">

                            <Button
                                android:id="@+id/btnTabMessages"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:backgroundTint="@color/input_background"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Msgs"
                                android:textColor="@color/text_primary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMessageBadge"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:layout_marginTop="2dp"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="#dc3545"
                                android:elevation="6dp"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </RelativeLayout>

                        <Button
                            android:id="@+id/btnTabAnalytics"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/input_background"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Analytics"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerReports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/sectionManualApprovals"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="#FFF3CD"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvManualApprovalsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️ Pending Manual Reviews"
                                android:textColor="#856404"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/listManualApprovals"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDeepSearchTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:text="Deep Search History"
                                android:textColor="@color/unifix_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinSearchCategory"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="8dp"
                                android:background="@color/input_background" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/etSearchUsername"
                                    android:layout_width="0dp"
                                    android:layout_height="50dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:background="@color/input_background"
                                    android:hint="Search user, category, or issue..."
                                    android:inputType="textNoSuggestions"
                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="12dp"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_hint"
                                    android:textSize="14sp" />

                                <Button
                                    android:id="@+id/btnSearchHistory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="50dp"
                                    android:backgroundTint="@color/unifix_blue"
                                    android:text="Search"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/listSearchResults"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="20dp"
                            android:background="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvActiveReportsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Active Reports Overview"
                            android:textColor="@color/unifix_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alignmentMode="alignMargins"
                            android:columnCount="3"
                            android:columnOrderPreserved="false">

                            <androidx.cardview.widget.CardView android:id="@+id/cardTechnology" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardIct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ICT" android:textColor="@color/unifix_blue" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvTechCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardDormitory" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardDorm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dormitory" android:textColor="@color/unifix_blue" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvDormCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardAcademic" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardAcad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Academic" android:textColor="@color/unifix_blue" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvAcademicCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardCafeteria" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardCafe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cafeteria" android:textColor="@color/unifix_blue" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvCafeteriaCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardHR" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardHr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Human Resource" android:textColor="#198754" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvHRCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardHealth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardHealth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Health Center" android:textColor="#198754" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvHealthCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardSecurity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardSec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Campus Security" android:textColor="#198754" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvSecurityCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardFinance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardFin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finance" android:textColor="#198754" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvFinanceCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardAdmin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardAdmin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Administration" android:textColor="#198754" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvAdminCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView android:id="@+id/cardOther" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/input_background" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvCardOther" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" android:textColor="@color/unifix_blue" android:textStyle="bold" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvOtherCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </GridLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btnToggleAddStaff"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginBottom="16dp"
                            android:backgroundTint="#198754"
                            android:text="➕ Add New Staff Member"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/sectionHeadAdmin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:background="@color/input_background"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvCreateStaffTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="👑 Create Staff Account"
                                android:textColor="@color/unifix_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etNewStaffUser"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/card_background"
                                android:hint="Username (e.g. admin5)"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/etNewStaffName"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/card_background"
                                android:hint="Full Name"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/etNewStaffPass"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/card_background"
                                android:hint=" Password"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="14sp" />

                            <Spinner
                                android:id="@+id/spinNewStaffRole"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="16dp"
                                android:background="@color/card_background" />

                            <Button
                                android:id="@+id/btnCreateStaff"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:backgroundTint="@color/unifix_blue"
                                android:text="Create Secure Account"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/listUsers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvCommunicationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Communication Center"
                            android:textColor="@color/unifix_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <Button
                                android:id="@+id/btnSubTabInbox"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="@color/unifix_blue"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Main Inbox"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnSubTabSpam"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:backgroundTint="@color/input_background"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Spam / Declined"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/adminInboxList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerAnalytics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvAnalyticsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Overall Campus Analytics"
                            android:textColor="@color/unifix_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="75dp"
                                android:layout_marginEnd="4dp"
                                app:cardBackgroundColor="#111111"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
                                    <TextView android:id="@+id/tvLabelTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOTAL REPORTS" android:textColor="#0d6efd" android:textSize="9sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvAnalyticsTotalReports" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="75dp"
                                android:layout_marginHorizontal="2dp"
                                app:cardBackgroundColor="#111111"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
                                    <TextView android:id="@+id/tvLabelPending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENDING" android:textColor="#ffc107" android:textSize="9sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvAnalyticsPending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="75dp"
                                android:layout_marginHorizontal="2dp"
                                app:cardBackgroundColor="#111111"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
                                    <TextView android:id="@+id/tvLabelResolved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESOLVED" android:textColor="#198754" android:textSize="9sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvAnalyticsResolved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="75dp"
                                android:layout_marginStart="4dp"
                                app:cardBackgroundColor="#111111"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
                                    <TextView android:id="@+id/tvLabelUsers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOTAL USERS" android:textColor="#0dcaf0" android:textSize="9sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvAnalyticsTotalUsers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="250dp"
                                android:layout_marginBottom="12dp"
                                app:cardBackgroundColor="#111111"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvChart1Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reports by Category" android:textColor="@color/text_primary" android:textStyle="bold"/>
                                    <com.github.mikephil.charting.charts.PieChart
                                        android:id="@+id/pieChartCategory"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="250dp"
                                android:layout_marginBottom="12dp"
                                app:cardBackgroundColor="#111111"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:id="@+id/tvChart2Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report Status Breakdown" android:textColor="@color/text_primary" android:textStyle="bold"/>
                                    <com.github.mikephil.charting.charts.BarChart
                                        android:id="@+id/barChartStatus"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:layout_marginBottom="16dp"
                            app:cardBackgroundColor="#111111"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="2dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
                                <TextView android:id="@+id/tvChart3Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆 Solver Performance (Completed Tasks)" android:textColor="#ffc107" android:textStyle="bold"/>
                                <com.github.mikephil.charting.charts.BarChart
                                    android:id="@+id/barChartSolver"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnDownloadCSV"
                                android:layout_width="0dp"
                                android:layout_height="55dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:backgroundTint="#198754"
                                android:text="📥 Get CSV"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnDownloadPDF"
                                android:layout_width="0dp"
                                android:layout_height="55dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="#dc3545"
                                android:text="📥 Get PDF"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>